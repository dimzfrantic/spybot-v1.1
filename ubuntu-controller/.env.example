# Konfigurasi utama dimzbot ubuntu-controller
TOKEN=isi-token-bot-telegram
GROUP_CHAT_ID=
ADMIN_TELEGRAM_ID=isi-user-id-admin-dm

# PC utama - Wake-on-LAN dan Windows agent
TARGET_MAC=AA:BB:CC:DD:EE:FF
TARGET_PC_IP=192.168.1.10
PC_AGENT_BASE_URL=http://192.168.1.10:8787
PC_AGENT_TOKEN=ubah-dengan-token-aman-sendiri
# Kosongkan agar controller memanggil /camera biasa. Isi 1 agar klik Camera memakai /camera?index=1.
PC_CAMERA_INDEX=

# User A - fitur terbatas (DM: hanya Nyalakan PC Saya)
# Isi data berikut jika ingin mengaktifkan akses User A.
USER_A_TELEGRAM_ID=isi-user-id-user-a
USER_A_PC_NAME=PC User A
USER_A_PC_MAC=11:22:33:44:55:66
# Kosongkan jika broadcast default jaringan sudah cukup.
USER_A_PC_BROADCAST=10.147.20.255
